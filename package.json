{
  "name": "crypto-zones",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"node --watch server/index.js\" \"vite\"",
    "dev:mock": "concurrently -k -n api,web -c cyan,magenta \"MOCK=1 node --watch server/index.js\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "express": "^4.22.3",
    "lightweight-charts": "^4.2.3",
    "postcss": "^8.5.32",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
